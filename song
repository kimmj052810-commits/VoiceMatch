* { box-sizing: border-box; }

:root {
  font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  color: #f5f7fb;
  background: #0d1020;
}

body {
  margin: 0;
  min-height: 100vh;
  background:
    radial-gradient(circle at 20% 10%, rgba(105, 75, 255, .28), transparent 35%),
    radial-gradient(circle at 85% 80%, rgba(0, 210, 255, .16), transparent 35%),
    #0d1020;
}

.app { width: min(800px, calc(100% - 32px)); margin: 0 auto; padding: 48px 0 32px; }
header { text-align: center; margin-bottom: 28px; }
.badge { display:inline-block; padding:6px 11px; border:1px solid rgba(255,255,255,.15); border-radius:999px; font-size:12px; letter-spacing:.08em; color:#bfc6ff; background:rgba(255,255,255,.05); }
h1 { font-size:clamp(32px,7vw,54px); line-height:1.1; margin:16px 0 12px; }
h1 span { color:#9f8cff; }
header p { color:#aeb5c9; }

.card {
  background:rgba(21,25,45,.86);
  border:1px solid rgba(255,255,255,.09);
  border-radius:24px;
  padding:28px;
  box-shadow:0 20px 70px rgba(0,0,0,.25);
  backdrop-filter:blur(14px);
}
.recorder-card { text-align:center; }
.timer { font-size:58px; font-weight:750; letter-spacing:.04em; margin:5px 0; }
.status { color:#aeb5c9; min-height:24px; margin-bottom:20px; }

.meter { height:8px; background:#292e48; border-radius:999px; overflow:hidden; margin-bottom:26px; }
#meterBar { width:0%; height:100%; background:linear-gradient(90deg,#8c72ff,#4ddcff); transition:width .08s linear; }

button { border:0; border-radius:14px; padding:13px 18px; font-size:16px; font-weight:700; cursor:pointer; }
.record-btn { color:white; background:#7659ff; min-width:170px; }
.record-btn:disabled,.secondary-btn:disabled { opacity:.45; cursor:not-allowed; }
.record-dot { display:inline-block; width:12px; height:12px; background:#ff5d78; border-radius:50%; margin-right:8px; }
.secondary-btn { color:#e9ecf7; background:#292e48; margin-left:8px; }

audio { width:100%; margin-top:20px; }
.hint { color:#7f879f; font-size:13px; margin-bottom:0; }

.result-card { margin-top:20px; }
.result-card h2 { margin-top:0; }

.stats {
  display:grid;
  grid-template-columns:repeat(4,1fr);
  gap:12px;
  margin:18px 0 22px;
}
.stats > div { background:#191e36; border-radius:16px; padding:16px; }
.stats span { display:block; color:#8992ab; font-size:13px; margin-bottom:7px; }
.stats strong { font-size:18px; }

.voice-bar-wrap { margin: 0 0 28px; }
.bar-label { display:flex; justify-content:space-between; color:#8992ab; font-size:12px; margin-bottom:7px; }
.voice-bar { height:10px; background:#292e48; border-radius:999px; overflow:hidden; }
#voiceBar { height:100%; width:0%; background:linear-gradient(90deg,#7659ff,#4ddcff); border-radius:999px; transition:width .5s ease; }

.recommend-title p { color:#9fa7bc; font-size:14px; }
.songs { display:grid; gap:12px; margin:15px 0 22px; }
.song {
  display:flex; align-items:center; gap:14px; padding:16px;
  border-radius:17px; background:#191e36; border:1px solid rgba(255,255,255,.06);
}
.rank { width:34px; height:34px; border-radius:10px; display:grid; place-items:center; background:#2a3155; font-weight:800; }
.song-info { flex:1; }
.song-info strong { display:block; font-size:17px; }
.song-info span { color:#8f97ae; font-size:13px; }
.song-meta { text-align:right; }
.match { font-size:14px; color:#9f8cff; font-weight:750; }
.key { color:#b8c0d5; font-size:12px; margin-top:3px; }

footer { text-align:center; color:#646c82; font-size:12px; margin-top:20px; }
footer .small { color:#50586e; }

@media (max-width: 680px) {
